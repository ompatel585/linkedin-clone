# Server
PORT=5000
NODE_ENV=development
# Leave MONGO_URI empty in development to use a throwaway in-memory MongoDB with demo data
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Set to true to load demo data into an empty database on startup
SEED_ON_START=false

# Optional: Cloudinary image hosting (images are stored inline when unset)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Mailtrap transactional email (emails are skipped when unset)
MAILTRAP_TOKEN=
EMAIL_FROM=
EMAIL_FROM_NAME=UnLinked
